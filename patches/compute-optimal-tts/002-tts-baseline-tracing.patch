new file mode 100644
--- /dev/null
+++ b/src/reason/tracing/tts_trace.py
@@ -0,0 +1,302 @@
+"""Readable per-problem hardware and software traces for TTS baseline runs.
+
+The hardware trace contains execution demand only.  The software trace is a
+separate profile artifact containing prompt/candidate text and PRM scores.
+Both files use the same stable IDs but neither embeds the other.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Sequence
+
+
+TRACE_SCHEMA_VERSION = "tts-trace-v1"
+
+
+def trace_root_from_env() -> Optional[Path]:
+    value = os.environ.get("ORCHES_TTS_TRACE_DIR", "").strip()
+    return Path(value).expanduser().resolve() if value else None
+
+
+def _problem_id(problem_inst: Dict[str, Any]) -> str:
+    explicit = problem_inst.get("trace_problem_id")
+    if explicit is not None:
+        return str(explicit)
+    file_path = str(problem_inst.get("file_path", ""))
+    match = re.search(r"question_(\d+)", file_path)
+    return match.group(1) if match else "unknown"
+
+
+def _json_dump(path: Path, document: Dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(document, ensure_ascii=False, indent=2, sort_keys=False) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def _message_text(messages: Sequence[Dict[str, Any]]) -> str:
+    return "\n".join(f"{message.get('role', 'unknown')}: {message.get('content', '')}" for message in messages)
+
+
+@dataclass
+class TTSProblemTrace:
+    root: Path
+    problem_inst: Dict[str, Any]
+    run_id: str
+    policy_model: str
+    prm_model: str
+    problem_id: str = field(init=False)
+    branches: Dict[str, Dict[str, Any]] = field(default_factory=dict)
+    policy_generations: List[Dict[str, Any]] = field(default_factory=list)
+    prm_forwards: List[Dict[str, Any]] = field(default_factory=list)
+    selections: List[Dict[str, Any]] = field(default_factory=list)
+    software_generations: List[Dict[str, Any]] = field(default_factory=list)
+    software_rewards: List[Dict[str, Any]] = field(default_factory=list)
+    _generation_counter: int = 0
+    _verification_counter: int = 0
+    _selection_counter: int = 0
+
+    def __post_init__(self) -> None:
+        self.problem_id = _problem_id(self.problem_inst)
+
+    @classmethod
+    def from_environment(
+        cls,
+        problem_inst: Dict[str, Any],
+        policy_model: str,
+        prm_model: str,
+    ) -> Optional["TTSProblemTrace"]:
+        root = trace_root_from_env()
+        if root is None:
+            return None
+        return cls(
+            root=root,
+            problem_inst=problem_inst,
+            run_id=os.environ.get("ORCHES_TTS_RUN_ID", root.name),
+            policy_model=policy_model,
+            prm_model=prm_model,
+        )
+
+    def root_branch_id(self) -> str:
+        return f"p{self.problem_id}.root"
+
+    def begin_generation(self, parent_branch_id: Optional[str], legal_actions: Sequence[Dict[str, Any]]) -> List[str]:
+        generation_id = f"p-{self._generation_counter}"
+        self._generation_counter += 1
+        parent_branch_id = parent_branch_id or self.root_branch_id()
+        prompt_tokens = int(legal_actions[0].get("prompt_tokens", 0)) if legal_actions else 0
+        children = []
+        branch_ids = []
+        for index, action in enumerate(legal_actions):
+            branch_id = f"p{self.problem_id}.g{self._generation_counter - 1}.b{index}"
+            branch_ids.append(branch_id)
+            completion_tokens = int(action.get("num_token", 0))
+            children.append({
+                "branch_id": branch_id,
+                "completion_tokens": completion_tokens,
+                "finish_reason": action.get("finish_reason"),
+            })
+            self.branches[branch_id] = {
+                "branch_id": branch_id,
+                "parent_branch_id": parent_branch_id,
+                "created_by": generation_id,
+                "shared_prefix_tokens": prompt_tokens,
+                "generated_tokens": completion_tokens,
+                "selected": None,
+                "final_selected": False,
+            }
+
+        ordered_lengths = sorted((child["completion_tokens"], child["branch_id"]) for child in children)
+        decode_segments = []
+        previous = 0
+        active = [branch_id for _, branch_id in ordered_lengths]
+        for length, branch_id in ordered_lengths:
+            if length > previous:
+                active_ids = [candidate for candidate in active]
+                decode_segments.append({
+                    "token_range": [previous, length],
+                    "branch_ids": active_ids,
+                    "batch_size": len(active_ids),
+                    "sequence_length_start": [prompt_tokens + previous] * len(active_ids),
+                    "sequence_length_end": [prompt_tokens + length] * len(active_ids),
+                })
+                previous = length
+            active.remove(branch_id)
+
+        self.policy_generations.append({
+            "generation_id": generation_id,
+            "parent_branch_id": parent_branch_id,
+            "service": "policy",
+            "model_id": self.policy_model,
+            "prompt_tokens": prompt_tokens,
+            "request_n": len(children),
+            "candidate_branch_ids": branch_ids,
+            "completion_tokens": [child["completion_tokens"] for child in children],
+            "prefill": {
+                "request_count": 1,
+                "prompt_tokens": [prompt_tokens],
+                "spawned_sequences": len(children),
+                "shared_prefix_tokens": prompt_tokens,
+            },
+            "decode_segments": decode_segments,
+        })
+
+        prompt_text = _message_text(legal_actions[0].get("messages", [])) if legal_actions else ""
+        self.software_generations.append({
+            "generation_id": generation_id,
+            "parent_branch_id": parent_branch_id,
+            "policy_model": self.policy_model,
+            "prompt_text": prompt_text,
+            "candidates": [
+                {
+                    "branch_id": branch_id,
+                    "output_text": action.get("raw_action", action.get("action", "")),
+                    "output_token_text": action.get("output_token_text", []),
+                    "finish_reason": action.get("finish_reason"),
+                }
+                for branch_id, action in zip(branch_ids, legal_actions)
+            ],
+        })
+        return branch_ids
+
+    def record_verification(
+        self,
+        generation_id: str,
+        branch_ids: Sequence[str],
+        qa_pairs: Sequence[Sequence[str]],
+        rewards: Sequence[Sequence[float]],
+        rm_callable: Any,
+    ) -> str:
+        verification_id = f"r-{self._verification_counter}"
+        self._verification_counter += 1
+        worker_inputs, token_lengths, execution_units = self._prm_execution_shape(qa_pairs, rm_callable)
+        self.prm_forwards.append({
+            "verification_id": verification_id,
+            "generation_id": generation_id,
+            "service": "prm",
+            "model_id": self.prm_model,
+            "branch_ids": list(branch_ids),
+            "logical_batch_size": len(branch_ids),
+            "valid_input_tokens": token_lengths,
+            "execution_units": execution_units,
+            "persistent_kv": False,
+        })
+        self.software_rewards.append({
+            "verification_id": verification_id,
+            "generation_id": generation_id,
+            "prm_model": self.prm_model,
+            "candidates": [
+                {
+                    "branch_id": branch_id,
+                    "prm_input_text": self._worker_input_text(worker_input, question, answer),
+                    "prm_score": float(score[-1]) if score else None,
+                    "step_rewards": [float(value) for value in score],
+                }
+                for branch_id, (question, answer), worker_input, score in zip(branch_ids, qa_pairs, worker_inputs, rewards)
+            ],
+        })
+        return verification_id
+
+    @staticmethod
+    def _worker_input_text(worker_input: Any, question: str, answer: str) -> str:
+        """Render the exact PRM worker payload only in the software trace."""
+        if isinstance(worker_input, str):
+            return worker_input
+        if isinstance(worker_input, (list, tuple)) and len(worker_input) == 2:
+            return f"{worker_input[0]}\n{worker_input[1]}"
+        return f"{question}\n{answer}"
+
+    def _prm_execution_shape(self, qa_pairs: Sequence[Sequence[str]], rm_callable: Any):
+        rm = getattr(rm_callable, "func", rm_callable)
+        model_name = getattr(rm, "model_name", self.prm_model)
+        tokenizer = getattr(rm, "tokenizer", None)
+        model_names = getattr(rm_callable, "keywords", {}).get("model_names", [self.policy_model])
+        try:
+            worker_inputs = rm.process_input(list(qa_pairs), model_names, verbose=False)
+        except Exception:
+            worker_inputs = [list(pair) for pair in qa_pairs]
+
+        token_lengths: List[int] = []
+        if tokenizer is not None and "skywork" in str(model_name).lower():
+            for question, answer in worker_inputs:
+                normalized = answer.replace("\n", "<|vision_start|>") + "<|vision_start|>"
+                prompt = tokenizer.bos_token + question + "\n"
+                token_lengths.append(len(tokenizer.encode(prompt)) + len(tokenizer.encode(normalized)))
+            execution_units = [
+                {"tensor_shape": [1, length], "valid_input_tokens": length, "execution_mode": "serial"}
+                for length in token_lengths
+            ]
+        elif tokenizer is not None and all(isinstance(item, str) for item in worker_inputs):
+            token_lengths = [len(tokenizer.encode(item)) for item in worker_inputs]
+            padded_length = max(token_lengths, default=0)
+            execution_units = [{
+                "tensor_shape": [len(token_lengths), padded_length],
+                "valid_input_tokens": token_lengths,
+                "execution_mode": "padded_batch",
+            }]
+        else:
+            token_lengths = [0] * len(qa_pairs)
+            execution_units = [{"tensor_shape": None, "valid_input_tokens": token_lengths, "execution_mode": "unknown"}]
+        return worker_inputs, token_lengths, execution_units
+
+    def record_selection(self, parent_branch_id: str, kept_branch_ids: Sequence[str]) -> None:
+        child_ids = [branch_id for branch_id, branch in self.branches.items() if branch["parent_branch_id"] == parent_branch_id]
+        if not child_ids:
+            return
+        selection_id = f"s-{self._selection_counter}"
+        self._selection_counter += 1
+        kept = list(kept_branch_ids)
+        pruned = [branch_id for branch_id in child_ids if branch_id not in kept]
+        for branch_id in child_ids:
+            self.branches[branch_id]["selected"] = branch_id in kept
+        self.selections.append({
+            "selection_id": selection_id,
+            "parent_branch_id": parent_branch_id,
+            "kept_branch_ids": kept,
+            "pruned_branch_ids": pruned,
+        })
+
+    def mark_final(self, branch_ids: Sequence[str]) -> None:
+        for branch_id in branch_ids:
+            if branch_id in self.branches:
+                self.branches[branch_id]["selected"] = True
+                self.branches[branch_id]["final_selected"] = True
+
+    def finalize(self, problem_is_correct: bool, final_paths: Sequence[Dict[str, Any]]) -> None:
+        key = f"problem_{int(self.problem_id):04d}" if self.problem_id.isdigit() else f"problem_{self.problem_id}"
+        for branch in self.branches.values():
+            if branch["selected"] is None:
+                branch["selected"] = False
+        software_generations = json.loads(json.dumps(self.software_generations))
+        for generation in software_generations:
+            for candidate in generation["candidates"]:
+                branch = self.branches[candidate["branch_id"]]
+                candidate["selected"] = branch["selected"]
+                candidate["final_selected"] = branch["final_selected"]
+        hw_document = {
+            "schema_version": TRACE_SCHEMA_VERSION,
+            "run_id": self.run_id,
+            "problem_id": self.problem_id,
+            "models": {"policy": self.policy_model, "prm": self.prm_model},
+            "branches": list(self.branches.values()),
+            "policy_generations": self.policy_generations,
+            "prm_forwards": self.prm_forwards,
+            "selections": self.selections,
+        }
+        sw_document = {
+            "schema_version": TRACE_SCHEMA_VERSION,
+            "run_id": self.run_id,
+            "problem_id": self.problem_id,
+            "question": {"text": self.problem_inst.get("question", ""), "answer": self.problem_inst.get("answer", "")},
+            "result": {"is_correct": bool(problem_is_correct), "final_paths": list(final_paths)},
+            "generation_events": software_generations,
+            "reward_events": self.software_rewards,
+            "search_events": self.selections,
+        }
+        _json_dump(self.root / "hw" / f"{key}.json", hw_document)
+        _json_dump(self.root / "sw" / f"{key}.json", sw_document)
