diff --git a/src/reason/llm_service/workers/determinism.py b/src/reason/llm_service/workers/determinism.py
new file mode 100644
index 0000000..e0b9bcd
--- /dev/null
+++ b/src/reason/llm_service/workers/determinism.py
@@ -0,0 +1,34 @@
+"""Strict deterministic-process setup for ORCHES TTS workers."""
+
+from __future__ import annotations
+
+import os
+import random
+
+
+def configure_worker_determinism() -> bool:
+    """Configure a worker before it creates a CUDA model or engine.
+
+    The launcher must set CUBLAS_WORKSPACE_CONFIG before Python starts.  This
+    function handles the remaining Python-level switches and returns whether
+    strict deterministic execution is enabled.
+    """
+    enabled = os.environ.get("ORCHES_TTS_STRICT_DETERMINISM", "1") == "1"
+    if not enabled:
+        return False
+
+    seed = int(os.environ.get("ORCHES_TTS_SEED", "0"))
+    os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
+
+    import torch
+
+    random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    torch.backends.cudnn.benchmark = False
+    torch.backends.cudnn.deterministic = True
+    torch.use_deterministic_algorithms(True)
+    return True
+    return True
